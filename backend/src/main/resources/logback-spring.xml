<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <property name="LOG_FILE_MAX_SIZE" value="${LOG_FILE_MAX_SIZE:-20MB}"/>
  <property name="LOG_FILE_MAX_HISTORY" value="${LOG_FILE_MAX_HISTORY:-14}"/>
  <property name="LOG_FILE_TOTAL_SIZE_CAP" value="${LOG_FILE_TOTAL_SIZE_CAP:-280MB}"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
      <charset>${CONSOLE_LOG_CHARSET}</charset>
    </encoder>
  </appender>

  <!-- File appender with JSON format -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/markitdone.json</file>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeContext>true</includeContext>
      <includeMdc>true</includeMdc>
      <customFields>{"service":"markitdone"}</customFields>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>logs/markitdone.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
      <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
      <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
      <totalSizeCap>${LOG_FILE_TOTAL_SIZE_CAP}</totalSizeCap>
    </rollingPolicy>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

  <include resource="org/springframework/boot/logging/logback/application.xml"/>
</configuration>
